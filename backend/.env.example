# Hugging Face User Access Token (read permission is sufficient for inference)
# Obtain from https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_api_token_here


# Model configurations
# Default embedding model: sentence-transformers/all-MiniLM-L6-v2 (fast on CPU/GPU)
# You can also use Qwen/Qwen3-Embedding-0.6B (from original Colab notebook)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
LLM_MODEL_NAME=Qwen/Qwen3-8B

# Device for embeddings: cuda or cpu (auto will use cuda if available)
DEVICE=auto

# Server configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
